// {theme_name} for Fastfetch. Generated by CORE from themes/{theme_id}/theme.toml; do not edit.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "data",
        "source": "      ◇\n     /|\\\n    / | \\\n   ◇--◇--◇\n   |\\ | /|\n   | \\|/ |\n   ◇--◇--◇\n     \\|/\n      ◇"
    },

    "display": {
        "separator": "  ",
        "key": {
            "width": 11
        },
        "color": {
            "keys": "{label}",
            "title": "{title}",
            "output": "{value}",
            "separator": "{separator}"
        },
        "percent": {
            "color": {
                "green": "{healthy}",
                "yellow": "{status}",
                "red": "{fault}"
            }
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;{title.rgb}m{theme_brand} // {apps.fastfetch.header}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{rule.rgb}m────────────────────────────\u001b[0m"
        },

        "break",

        {
            "type": "os",
            "key": "SYSTEM"
        },
        {
            "type": "host",
            "key": "HOST"
        },
        {
            "type": "cpu",
            "key": "PROCESSOR"
        },
        {
            "type": "memory",
            "key": "MEMORY"
        },
        {
            "type": "disk",
            "key": "STORAGE"
        },

        "break",

        {
            "type": "display",
            "key": "DISPLAY"
        },
        {
            "type": "terminal",
            "key": "TERMINAL"
        },
        {
            "type": "shell",
            "key": "SHELL"
        },

        "break",

        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "battery",
            "key": "POWER"
        },
        {
            "type": "localip",
            "key": "NETWORK"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[38;2;{healthy.rgb}m● ONLINE\u001b[0m   \u001b[38;2;{badge.rgb}m◆ {theme_short}\u001b[0m"
        }
    ]
}
