palette = 4={terminal.ansi.blue}
palette = 5={terminal.ansi.magenta}
palette = 6={terminal.ansi.cyan}
palette = 7={terminal.ansi.white}
palette = 8={terminal.ansi.bright_black}
palette = 9={terminal.ansi.bright_red}
palette = 10={terminal.ansi.bright_green}
palette = 11={terminal.ansi.bright_yellow}
palette = 12={terminal.ansi.bright_blue}
palette = 13={terminal.ansi.bright_magenta}
palette = 14={terminal.ansi.bright_cyan}
palette = 15={terminal.ansi.bright_white}
