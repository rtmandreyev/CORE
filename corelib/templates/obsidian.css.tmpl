/* {theme_name} for Obsidian.
   Generated by CORE from themes/{theme_id}/theme.toml; do not edit this file.
   The rule targets body.theme-dark and body.theme-light so the theme renders
   the same whichever base appearance a vault uses. */

body.theme-dark,
body.theme-light {

{{#dark}}  color-scheme: dark;
  --mono-0: black;
  --mono-100: white;
{{/dark}}{{#light}}  color-scheme: light;
  --mono-0: white;
  --mono-100: black;
{{/light}}  --highlight-mix-blend-mode: normal;

  --core-bg: {canvas};
  --core-surface: {surface};
  --core-surface-2: {surface_2};
  --core-surface-3: {surface_3};

  --core-border: {border};
  --core-border-bright: {border_bright};

  --core-fg: {body};
  --core-fg-bright: {strong};
  --core-muted: {muted};
  --core-dim: {dim};

  --core-signal: {accent};
  --core-signal-bright: {accent_bright};
  --core-signal-dim: {accent_dim};
  --core-meta: {dim};
  --core-blue: {apps.obsidian.blue};
  --core-success: {success};
  --core-command: {warning};
  --core-command-bright: {warning_bright};
  --core-fault: {error};
  --core-fault-bright: {error_bright};

  --core-hover: {hover};
  --core-selected: {active};
  --core-selection: {selection};
  --core-selection-fg: {selection_foreground};

  --core-chrome: {chrome};
  --core-chrome-alt: {chrome_alt};
  --core-chrome-active: {chrome_active};

  --core-icon: {icon};
  --core-icon-hover: {icon_hover};
  --core-icon-active: {icon_active};

  --core-control-fill: {control_fill};
  --core-control-fill-hover: {accent_dim};
  --core-control-legend: {control_legend};

  --background-primary: var(--core-bg);
  --background-primary-alt: var({apps.obsidian.primary_alt_var});
  --background-secondary: var(--core-chrome);
  --background-secondary-alt: var(--core-surface-2);

  --background-modifier-hover: var(--core-hover);
  --background-modifier-active-hover: var(--core-surface-3);
  --background-modifier-border: var(--core-border);
  --background-modifier-border-hover: var(--core-border-bright);
  --background-modifier-border-focus: var(--core-signal);
  --background-modifier-error: var(--core-fault);
  --background-modifier-error-hover: var(--core-fault-bright);
  --background-modifier-error-rgb: {error.rgb_csv};
  --background-modifier-success: var(--core-success);
  --background-modifier-success-rgb: {success.rgb_csv};
  --background-modifier-warning: var(--core-command);
  --background-modifier-warning-hover: var(--core-command-bright);
  --background-modifier-message: var(--core-surface-2);
  --background-modifier-box-shadow: {canvas}40;
  --background-modifier-cover: {canvas}99;

  --text-normal: var(--core-fg);
  --text-muted: var(--core-muted);
  --text-faint: var(--core-dim);

  --text-accent: var(--core-signal);
  --text-accent-hover: var({apps.obsidian.accent_hover_var});
  --text-primary-color: var(--core-fg);
  --text-secondary-color: var(--core-muted);

  --text-on-accent: var(--core-control-legend);
  --text-on-accent-inverted: var(--core-bg);

  --text-success: var(--core-success);
  --text-warning: var(--core-command);
  --text-error: var(--core-fault);

  --text-selection: {selection}F2;
  --text-highlight-bg: {highlight_bg}{apps.obsidian.highlight_alpha};
  --text-highlight-bg-rgb: {highlight_bg.rgb_csv};
  --highlight-bg-color: {highlight_bg};
  --highlight-selected-bg-color: {highlight_bg};

  --caret-color: var(--core-fg);

  --interactive-normal: var(--core-surface-2);
  --interactive-hover: var(--core-surface-3);
  --interactive-accent: var(--core-control-fill);
  --interactive-accent-hover: var(--core-control-fill-hover);
  --interactive-accent-hsl: var(--color-accent-hsl);

  --background-modifier-form-field: var({apps.obsidian.form_field_var});
  --background-modifier-form-field-hover: var(--core-surface-2);
  --background-modifier-form-field-highlighted: var(--core-surface-3);

  --color-accent: var(--core-signal);
  --color-accent-1: var(--core-signal);
  --color-accent-2: var(--core-signal);

  --shadow-edges: 0 0 transparent;
{{#if apps.obsidian.deep_shadows}}  --shadow-xs: 0 1px 6px rgba({apps.obsidian.shadow.rgb_csv}, 0.35), 0 4px 24px rgba({apps.obsidian.shadow.rgb_csv}, 0.45), var(--shadow-edges);{{/if}}{{#unless apps.obsidian.deep_shadows}}  --shadow-xs: 0 1px 6px rgba({apps.obsidian.shadow.rgb_csv}, 0.015), 0 4px 24px rgba({apps.obsidian.shadow.rgb_csv}, 0.065), var(--shadow-edges);{{/unless}}
{{#if apps.obsidian.deep_shadows}}  --shadow-s: 0 1px 2px rgba({apps.obsidian.shadow.rgb_csv}, 0.45), 0 3.4px 6.7px rgba({apps.obsidian.shadow.rgb_csv}, 0.5), 0 15px 30px rgba({apps.obsidian.shadow.rgb_csv}, 0.55);{{/if}}{{#unless apps.obsidian.deep_shadows}}  --shadow-s: 0 1px 2px rgba({apps.obsidian.shadow.rgb_csv}, 0.028), 0 3.4px 6.7px rgba({apps.obsidian.shadow.rgb_csv}, 0.042), 0 15px 30px rgba({apps.obsidian.shadow.rgb_csv}, 0.07);{{/unless}}
{{#if apps.obsidian.deep_shadows}}  --shadow-l: 0 1.8px 7.3px rgba({apps.obsidian.shadow.rgb_csv}, 0.5), 0 6.3px 24.7px rgba({apps.obsidian.shadow.rgb_csv}, 0.6), 0 15px 30px rgba({apps.obsidian.shadow.rgb_csv}, 0.65);{{/if}}{{#unless apps.obsidian.deep_shadows}}  --shadow-l: 0 1.8px 7.3px rgba({apps.obsidian.shadow.rgb_csv}, 0.071), 0 6.3px 24.7px rgba({apps.obsidian.shadow.rgb_csv}, 0.112), 0 15px 30px rgba({apps.obsidian.shadow.rgb_csv}, 0.1);{{/unless}}
{{#if apps.obsidian.deep_shadows}}  --input-shadow: inset 0 0 0 1px rgba({apps.obsidian.shadow.rgb_csv}, 0.6), 0 1px 2px 0 rgba({apps.obsidian.shadow.rgb_csv}, 0.5), 0 0 0 0 transparent;{{/if}}{{#unless apps.obsidian.deep_shadows}}  --input-shadow: inset 0 0 0 1px rgba({apps.obsidian.shadow.rgb_csv}, 0.12), 0 1px 2px 0 rgba({apps.obsidian.shadow.rgb_csv}, 0.065), 0 0 0 0 transparent;{{/unless}}
{{#if apps.obsidian.deep_shadows}}  --input-shadow-hover: inset 0 0 0 1px rgba({apps.obsidian.shadow.rgb_csv}, 0.7), 0 1px 2px 0 rgba({apps.obsidian.shadow.rgb_csv}, 0.6), 0 0 0 0 transparent;{{/if}}{{#unless apps.obsidian.deep_shadows}}  --input-shadow-hover: inset 0 0 0 1px rgba({apps.obsidian.shadow.rgb_csv}, 0.17), 0 1px 2px 0 rgba({apps.obsidian.shadow.rgb_csv}, 0.1), 0 0 0 0 transparent;{{/unless}}

  --titlebar-background: var(--core-chrome);
  --titlebar-background-focused: var(--core-chrome);
  --titlebar-border-width: 0px;
  --titlebar-border-color: var(--core-border);
  --titlebar-text-color: var(--core-muted);
  --titlebar-text-color-focused: var(--core-fg-bright);
  --titlebar-text-weight: 600;

  --tab-container-background: var(--core-chrome);

  --tab-background-active: var(--core-chrome-alt);
  --tab-text-color: var(--core-muted);
  --tab-text-color-active: var(--core-muted);
  --tab-text-color-focused: var(--core-muted);
  --tab-text-color-focused-active: var({apps.obsidian.tab_active_text_var});
  --tab-text-color-focused-active-current: var(--core-fg-bright);
  --tab-text-color-focused-highlighted: var(--core-signal);
  --tab-divider-color: var(--core-border);
  --tab-outline-color: var(--core-border);
  --tab-outline-width: 1px;
  --tab-radius: var(--radius-s);
  --tab-radius-active: 4px 4px 0 0;
  --tab-curve: 0px;
  --tab-font-weight: 600;

{{#if apps.obsidian.deep_shadows}}  --tab-stacked-shadow: 0 -8px 8px 0 rgba({apps.obsidian.shadow.rgb_csv}, 0.45);{{/if}}{{#unless apps.obsidian.deep_shadows}}  --tab-stacked-shadow: 0 -8px 8px 0 rgba({apps.obsidian.shadow.rgb_csv}, 0.05);{{/unless}}

  --ribbon-background: var(--core-chrome);
  --ribbon-background-collapsed: var(--core-chrome-alt);

  --icon-color: {icon};
  --icon-color-hover: {icon_hover};
  --icon-color-active: {icon_active};
  --icon-color-focus: {icon_active};
  --icon-color-focused: {icon_active};
  --icon-opacity: 1;
  --icon-opacity-hover: 1;
  --icon-opacity-active: 1;
  --icon-stroke: 1.5px;

  --collapse-icon-color: var(--core-dim);
  --collapse-icon-color-collapsed: var(--core-muted);

  --clickable-icon-radius: var(--radius-s);

  --nav-item-color: var(--core-muted);
  --nav-item-color-hover: var(--core-fg);

  --nav-item-color-active: var({apps.obsidian.nav_active_var});
  --nav-item-color-selected: var({apps.obsidian.nav_selected_var});
  --nav-item-color-highlighted: var(--core-signal);
  --nav-item-background-hover: var(--core-hover);
  --nav-item-background-active: var(--core-chrome-active);
  --nav-item-background-selected: var(--core-chrome-active);
  --nav-item-radius: var(--radius-s);
  --nav-item-color-collapsed: var(--core-muted);

  --nav-collapse-icon-color: var(--core-dim);
  --nav-collapse-icon-color-collapsed: var(--core-muted);
  --nav-heading-color: var(--core-muted);
  --nav-heading-color-hover: var(--core-fg);
  --nav-heading-color-collapsed: var(--core-dim);

  --nav-tag-color: var(--core-command);
  --nav-tag-color-active: var(--core-command);
  --nav-tag-color-hover: var(--core-command);
  --nav-tag-radius: var(--radius-s);

  --vault-profile-color: var(--core-muted);
  --vault-profile-color-hover: var(--core-fg);

  --file-header-background: var(--core-chrome);
  --file-header-background-focused: var(--core-chrome-alt);
  --file-header-border: none;
  --file-header-font-weight: 600;

  --status-bar-background: var(--core-chrome);
  --status-bar-text-color: var(--core-muted);
  --status-bar-border-color: var(--core-border);
  --status-bar-border-width: 1px 0 0 0;
  --status-bar-radius: 0;

  --divider-color: var(--core-border);
  --divider-color-hover: var(--core-signal);
  --divider-width: 1px;
  --divider-width-hover: 2px;

  --indentation-guide-color: var(--core-border);
  --indentation-guide-color-active: var(--core-signal);
  --indentation-guide-width: 1px;
  --indentation-guide-width-active: 2px;

  --scrollbar-bg: transparent;
  --scrollbar-thumb-bg: {scrollbar};
  --scrollbar-active-thumb-bg: var({apps.obsidian.scrollbar_active_var});
  --scrollbar-radius: var(--radius-m);
  --scrollbar-width: 12px;

  --menu-background: var(--core-chrome-alt);
  --menu-border-color: var(--core-border);
  --menu-border-width: 1px;
  --menu-radius: var(--radius-m);
  --menu-divider-color: var(--core-border);
  --menu-divider-width: 1px;
  --menu-shadow: var(--shadow-s);
  --menu-padding: 4px;

  --prompt-background: var(--core-chrome-alt);
  --prompt-border-color: var(--core-border);
  --prompt-border-width: 1px;
  --prompt-input-height: 44px;

  --suggestion-background: var(--core-chrome-alt);
  --suggestion-backdrop-filter: none;

  --search-result-background: var(--core-chrome-alt);
  --search-icon-color: var(--core-dim);
  --search-clear-button-color: var(--core-dim);
  --search-input-radius: var(--radius-s);

  --modal-background: var(--core-chrome-alt);
  --modal-sidebar-background: var(--core-chrome);
  --modal-border-color: var(--core-border);
  --modal-border-width: 1px;
  --modal-radius: var(--radius-l);
  --modal-shadow: var(--shadow-l);

  --settings-background: var(--core-chrome-alt);
  --settings-home-background: var(--core-chrome-alt);
  --setting-items-background: var(--core-chrome);
  --setting-items-border-color: var(--core-border);
  --setting-items-radius: var(--radius-m);
  --setting-group-heading-color: var(--core-fg);

  --input-radius: var(--radius-s);
  --input-height: 32px;
  --input-padding: 4px 8px;
  --input-text-bg-color: var(--core-chrome-alt);
  --input-text-fg-color: var(--core-fg);
  --input-placeholder-color: var(--core-dim);
  --input-unfocused-border-color: var(--core-border);
  --input-hover-border-color: var(--core-signal);
  --input-focus-border-color: var(--core-signal);
  --input-focus-outline: 1px solid var(--core-signal);
  --input-disabled-border-color: var(--core-border);
  --input-font-weight: 500;

  --pill-color: var(--core-muted);
  --pill-color-hover: var(--core-fg);
  --pill-color-remove: var(--core-dim);
  --pill-color-remove-hover: var(--core-signal);
  --pill-background: var(--core-chrome);
  --pill-border-color: var(--core-border);
  --pill-border-color-hover: var(--core-signal);
  --pill-radius: var(--radius-s);

  --checkbox-color: {checkbox};
  --checkbox-color-hover: {checkbox};
  --checkbox-border-color: var(--core-border);
  --checkbox-border-color-hover: var(--core-signal);
  --checkbox-marker-color: var({apps.obsidian.checkbox_marker_var});
  --checkbox-radius: var(--radius-s);
  --checklist-done-color: var(--core-dim);

  --toggle-thumb-color: var(--core-fg-bright);
  --toggle-thumb-opacity-active: 1;

  --slider-thumb-background: var(--core-control-legend);
  --slider-thumb-background-hover: var(--core-fg);
  --slider-fill-background: var(--core-control-fill);
  --slider-track-background: var(--core-border);

  --tag-color: {tag_text};
  --tag-color-hover: {tag_text};
  --tag-background: {tag_bg};
  --tag-background-hover: var(--core-surface-3);
  --tag-border-color: var(--core-border);
  --tag-border-color-hover: var(--core-border-bright);
  --tag-border-width: 1px;
  --tag-radius: var(--radius-s);

  --metadata-background: transparent;
  --metadata-border-color: var(--core-border);
  --metadata-divider-color: var(--core-border);
  --metadata-divider-color-hover: transparent;
  --metadata-divider-color-focus: transparent;
  --metadata-property-background: transparent;
  --metadata-property-background-hover: var(--core-hover);
  --metadata-property-background-active: var(--core-surface-3);
  --metadata-property-box-shadow: none;
  --metadata-property-radius: var(--radius-s);
  --metadata-label-background: transparent;
  --metadata-label-text-color: var(--core-muted);
  --metadata-label-text-color-hover: var(--core-fg);
  --metadata-label-background-active: transparent;
  --metadata-input-background: transparent;
  --metadata-input-background-hover: transparent;
  --metadata-input-background-active: var(--core-hover);
  --metadata-input-text-color: var(--core-fg);

  --callout-border-width: 1px;
  --callout-border-opacity: 1;
  --callout-radius: var(--radius-m);
  --callout-padding: 12px 16px;
  --callout-title-color: rgb(var(--callout-color));
  --callout-title-weight: 700;
  --callout-content-background: transparent;
  --callout-content-padding: 0;

  --table-background: transparent;
  --table-border-width: 1px;
  --table-border-color: var(--core-border);
  --table-header-background: var(--core-chrome);
  --table-header-background-hover: var(--core-surface-3);
  --table-header-color: var(--core-fg-bright);
  --table-header-border-color: var(--core-border-bright);
  --table-text-color: var(--core-fg);
  --table-row-background-hover: var(--core-hover);
  --table-row-alt-background: transparent;
  --table-row-alt-background-hover: var(--core-hover);
  --table-selection: {selection}F2;
  --table-selection-border-color: var(--core-signal);

  --blockquote-color: var(--core-muted);
  --blockquote-background-color: transparent;
  --blockquote-border-color: var(--core-signal);
  --blockquote-border-thickness: 2px;
  --blockquote-font-style: normal;

  --hr-color: var(--core-border);
  --hr-thickness: 1px;

  --list-marker-color: var(--core-muted);
  --list-marker-color-hover: var(--core-fg);
  --list-marker-color-collapsed: var(--core-signal);

  --embed-background: var(--core-chrome);
  --embed-border-left: 2px solid var(--core-border);
  --embed-border-right: none;
  --embed-border-top: none;
  --embed-border-bottom: none;
  --embed-block-shadow-hover: 0 0 0 1px var(--core-border);

  --graph-line: var(--core-border);
  --graph-node: var(--core-signal);
  --graph-node-focused: var({apps.obsidian.graph_focused_var});
  --graph-node-tag: var({apps.obsidian.graph_tag_var});
  --graph-node-attachment: var({apps.obsidian.graph_attachment_var});
  --graph-node-unresolved: var(--core-dim);
  --graph-text: var(--core-fg);

  --code-background: {code_bg};
  --code-border-color: {code_border};
  --code-border-width: 0px;
  --code-radius: var(--radius-s);
  --code-size: var(--font-smaller);
  --code-white-space: pre-wrap;
  --code-bracket-background: {code_bracket_bg};

  --code-normal: {code_text};
  --code-comment: {code_comment};
  --code-function: {code_function};
  --code-keyword: {code_keyword};
  --code-operator: {code_operator};
  --code-property: {code_property};
  --code-punctuation: {code_punctuation};
  --code-string: {code_string};
  --code-tag: {code_tag};
  --code-value: {code_number};
  --code-important: {code_important};

  --radius-s: 3px;
  --radius-m: 4px;
  --radius-l: 5px;
  --radius-xl: 6px;
  --border-width: 1px;
}

::selection {
  background: {selection};
  color: {selection_foreground};
}

body.theme-dark ::selection,
body.theme-light ::selection {
  background: {selection};
  color: {selection_foreground};
}

.workspace-tabs,
.workspace-tab-header,
.workspace-ribbon,
.side-dock-ribbon,
.nav-files-container,
.nav-header,
.status-bar,
.metadata-container,
.modal,
.menu,
.suggestion-container,
.prompt,
.setting-item,
.tag {
  font-family:
    "JetBrainsMono Nerd Font Mono",
    "JetBrains Mono",
    monospace;
}

.workspace-split.mod-left-split,
.workspace-split.mod-right-split {
  background: var(--core-chrome);
}

.workspace-leaf-resize-handle {
  border-color: var(--core-border);
}

.workspace-tab-header-container {
  background: var(--tab-container-background);
}

.workspace-split.mod-left-split .workspace-leaf-content,
.workspace-split.mod-right-split .workspace-leaf-content {
  background: var(--core-chrome-alt);
}

.workspace-tab-header {
  border-radius: 4px 4px 0 0;
  transition:
    color 100ms ease,
    background-color 100ms ease;
}

.workspace-tab-header.is-active {
  color: var(--tab-text-color-focused-active-current);
  background: var(--tab-background-active);
  box-shadow:
    inset 0 -1px 0 var(--core-signal);
}

.workspace-tab-header:not(.is-active):hover {
  color: var(--core-fg);
  background: {hover};
}

.workspace-tab-header-inner-title {
  font-weight: 600;
}

.side-dock-ribbon,
.workspace-ribbon {
  background: var(--ribbon-background);
}

.clickable-icon {
  color: var(--icon-color);
  border-radius: 3px;
}

.clickable-icon:hover,
.clickable-icon.is-active {
  color: var(--icon-color-hover);
  background: {hover};
}

.nav-file-title,
.nav-folder-title {
  border-radius: 3px;
}

.nav-file-title:hover,
.nav-folder-title:hover {
  color: var(--core-fg);
}

.nav-file-title.is-active,
.nav-folder-title.is-active {
  color: var(--nav-item-color-selected);
  background: var(--core-selected);
  box-shadow: inset 2px 0 0 var(--core-signal);
}

.nav-file-title.is-selected,
.nav-folder-title.is-selected {
  color: var(--nav-item-color-selected);
  background: var(--core-selected);
}

.nav-folder-title {
  color: var(--core-muted);
}

.nav-file-tag {
  color: var(--nav-tag-color);
}

.markdown-source-view,
.markdown-reading-view {
  background: var(--core-bg);
}

.markdown-rendered {
  color: var(--core-fg);
}

.cm-cursor,
.cm-dropCursor {
  border-left-color: {apps.obsidian.caret} !important;
}

.cm-editor.cm-focused .cm-matchingBracket {
  background-color: {code_bracket_bg};
  box-shadow: inset 0 0 0 1px var(--core-signal);
  color: var(--core-fg-bright);
}

.markdown-rendered h1,
.HyperMD-header-1 {
  color: {heading_1};
  letter-spacing: -0.025em;

  border-bottom: 1px solid {heading_ornament};
  padding-bottom: 3px;
}

.markdown-rendered h2,
.HyperMD-header-2 {
  color: {heading_2};
}

.markdown-rendered h3,
.HyperMD-header-3 {
  color: {heading_3};
}

.markdown-rendered h4,
.HyperMD-header-4 {
  color: {heading_4};
}

.markdown-rendered h5,
.HyperMD-header-5 {
  color: {heading_5};
}

.markdown-rendered h6,
.HyperMD-header-6 {
  color: {heading_6};
}

.cm-hmd-internal-link,
.internal-link {
  color: {link};
}

.internal-link:hover,
.external-link:hover,
.cm-hmd-internal-link:hover {
  color: {link};
  text-decoration: underline;
}

  .is-unresolved {
  color: var({apps.obsidian.unresolved_var});
}

a.tag,
.tag {
  color: {tag_text};
  background: {tag_bg};
  border: 1px solid var(--core-border);
  border-radius: 4px;
  padding-inline: 6px;
}

a.tag:hover,
.tag:hover {
  color: {tag_text};
  background: var(--core-surface-3);
  border-color: var(--core-border-bright);
}

.cm-hashtag {
  color: {link};
}

.cm-hashtag-end {
  color: {link};
}

.metadata-container {
  --metadata-label-width: 9em;
}

.metadata-property {
  border-radius: 3px;
}

.metadata-property:hover {
  background: {hover};
}

.metadata-property-key {
  color: var(--core-muted);
}

.metadata-property-value {
  color: var(--core-fg);
}

.metadata-property-icon {
  color: {metadata_icon};
}

.metadata-add-button {
  color: {metadata_add};
}

.metadata-add-button:hover {
  color: {link};
}

.callout {
  border-radius: 4px;
  border: 1px solid var(--core-border);
  border-left: 2px solid rgb(var(--callout-color));
  background: {apps.obsidian.callout_bg}EB;
  box-shadow: none;
}

.callout-title {
  color: rgb(var(--callout-color));
  font-family:
    "JetBrainsMono Nerd Font Mono",
    "JetBrains Mono",
    monospace;
  font-weight: 700;
}

.callout-content {
  color: var(--core-fg);
}

.callout[data-callout="info"],
.callout[data-callout="tip"],
.callout[data-callout="abstract"],
.callout[data-callout="summary"] {
  --callout-color: {accent.rgb_csv};
}

.callout[data-callout="success"],
.callout[data-callout="check"],
.callout[data-callout="done"] {
  --callout-color: {success_bright.rgb_csv};
}

.callout[data-callout="warning"],
.callout[data-callout="caution"],
.callout[data-callout="attention"] {
  --callout-color: {warning.rgb_csv};
}

.callout[data-callout="danger"],
.callout[data-callout="error"],
.callout[data-callout="failure"],
.callout[data-callout="fail"],
.callout[data-callout="bug"] {
  --callout-color: {error.rgb_csv};
}

.callout[data-callout="note"] {
  --callout-color: {apps.obsidian.note_callout.rgb_csv};
}

input[type="checkbox"] {
  border-radius: 3px;
}

.task-list-item-checkbox {
  border-color: var(--checkbox-border-color);
}

.markdown-rendered input[type="checkbox"]:checked,
.markdown-source-view input[type="checkbox"]:checked {
  background-color: {checkbox};
  border-color: {checkbox};
}

.task-list-item.is-checked {
  color: var(--core-dim);
}

.task-list-item.is-checked input[type="checkbox"] {
  background-color: {checkbox};
  border-color: {checkbox};
}

.checkbox-container {
  background-color: var(--core-surface-3);
{{#if apps.obsidian.deep_shadows}}  box-shadow: inset 0 1px 3px rgba({apps.obsidian.shadow.rgb_csv}, 0.55);{{/if}}{{#unless apps.obsidian.deep_shadows}}  box-shadow: inset 0 1px 3px rgba({apps.obsidian.shadow.rgb_csv}, 0.12);{{/unless}}
}

.checkbox-container.is-enabled {
  background-color: {checkbox};
}

.markdown-rendered table {
  border-collapse: collapse;
  background: var(--core-bg);
}

.markdown-rendered th {
  color: var(--core-fg-bright);
  background: var(--core-chrome);
  border-color: var(--core-border-bright);
  font-family:
    "JetBrainsMono Nerd Font Mono",
    "JetBrains Mono",
    monospace;
}

.markdown-rendered td {
  color: var(--core-fg);
  border-color: var(--core-border);
}

.markdown-rendered tr:hover td {
  background: {hover};
}

.markdown-rendered code,
.cm-s-obsidian span.cm-inline-code,
:not(pre) > code {
  color: {apps.obsidian.inline_code};
  background: {code_bg};
  border: 1px solid {code_border};
  border-radius: 3px;
  padding: 0.1em 0.3em;
}

.cm-s-obsidian span.cm-inline-code {
  border-color: {code_border};
}

pre,
.markdown-rendered pre,
.cm-preview-code-block pre {
  background: {code_bg};
  border: 1px solid {code_border};
  border-radius: 4px;
  box-shadow: none;
}

pre code {
  color: {code_text};
  font-family:
    "JetBrainsMono Nerd Font Mono",
    "JetBrains Mono",
    monospace;
}

.cm-s-obsidian .cm-line.HyperMD-codeblock,
.cm-s-obsidian .HyperMD-codeblock-begin,
.cm-s-obsidian .HyperMD-codeblock-end {
  color: {code_text};
}

.cm-s-obsidian .code-block-flair {
  color: var(--core-muted);
  background: {code_bg};
}

.cm-s-obsidian .code-block-flair:hover {
  color: var(--core-fg-bright);
  background: {selection};
}

.cm-s-obsidian .cm-number.cm-number,
.cm-s-obsidian .cm-comment.cm-comment,
.cm-s-obsidian .cm-keyword.cm-keyword,
.cm-s-obsidian .cm-string.cm-string,
.cm-s-obsidian .cm-string-2.cm-string-2,
.cm-s-obsidian .cm-variable.cm-variable,
.cm-s-obsidian .cm-variable-2.cm-variable-2,
.cm-s-obsidian .cm-variable-3.cm-variable-3,
.cm-s-obsidian .cm-def.cm-def,
.cm-s-obsidian .cm-operator.cm-operator,
.cm-s-obsidian .cm-punctuation.cm-punctuation,
.cm-s-obsidian .cm-bracket.cm-bracket,
.cm-s-obsidian .cm-meta.cm-meta,
.cm-s-obsidian .cm-atom.cm-atom,
.cm-s-obsidian .cm-qualifier.cm-qualifier,
.cm-s-obsidian .cm-hr.cm-hr,
.cm-s-obsidian .cm-attribute.cm-attribute,
.cm-s-obsidian .cm-tag.cm-tag,
.cm-s-obsidian .cm-builtin.cm-builtin,
.cm-s-obsidian .cm-property.cm-property,
.cm-s-obsidian .cm-type.cm-type,
.cm-s-obsidian .cm-function.cm-function,
.cm-s-obsidian .cm-link.cm-link {
  color: {code_text};
}

.cm-s-obsidian .cm-variable.cm-variable,
.cm-s-obsidian .cm-variable-2.cm-variable-2,
.cm-s-obsidian .cm-variable-3.cm-variable-3,
.cm-s-obsidian .cm-def.cm-def,
.cm-s-obsidian .cm-punctuation.cm-punctuation,
.cm-s-obsidian .cm-bracket.cm-bracket,
.cm-s-obsidian .cm-hr.cm-hr {
  color: {code_punctuation};
}

.cm-s-obsidian .cm-keyword.cm-keyword,
.cm-s-obsidian .cm-attribute.cm-attribute {
  color: {code_keyword};
}

.cm-s-obsidian .cm-tag.cm-tag {
  color: {code_tag};
}

.cm-s-obsidian .cm-string.cm-string,
.cm-s-obsidian .cm-string-2.cm-string-2,
.cm-s-obsidian .cm-number.cm-number,
.cm-s-obsidian .cm-atom.cm-atom {
  color: {code_string};
}

.cm-s-obsidian .cm-builtin.cm-builtin,
.cm-s-obsidian .cm-property.cm-property,
.cm-s-obsidian .cm-type.cm-type,
.cm-s-obsidian .cm-function.cm-function {
  color: {code_function};
}

.cm-s-obsidian .cm-comment.cm-comment,
.cm-s-obsidian .cm-meta.cm-meta {
  color: {code_comment};
}

.cm-s-obsidian .cm-operator.cm-operator {
  color: {code_operator};
}

.cm-s-obsidian .cm-link.cm-link {
  color: {link};
}

.cm-s-obsidian span.cm-invalidchar,
.cm-s-obsidian span.cm-error,
.cm-s-obsidian .cm-invalidchar {
  color: {code_invalid};
}

@media print {
  code[class*="language-"] {
    text-shadow: none;
  }
}

.markdown-rendered pre code .token.comment,
.markdown-rendered pre code .token.prolog,
.markdown-rendered pre code .token.doctype,
.markdown-rendered pre code .token.cdata {
  color: {code_comment};
}

.markdown-rendered pre code .token.punctuation,
.markdown-rendered pre code .token.operator {
  color: {code_operator};
}

.markdown-rendered pre code .token.number,
.markdown-rendered pre code .token.boolean,
.markdown-rendered pre code .token.constant,
.markdown-rendered pre code .token.symbol {
  color: {code_string};
}

.markdown-rendered pre code .token.string,
.markdown-rendered pre code .token.char,
.markdown-rendered pre code .token.selector,
.markdown-rendered pre code .token.attr-name,
.markdown-rendered pre code .token.inserted {
  color: {code_string};
}

.markdown-rendered pre code .token.keyword,
.markdown-rendered pre code .token.atrule,
.markdown-rendered pre code .token.attr-value,
.markdown-rendered pre code .token.tag {
  color: {code_keyword};
}

.markdown-rendered pre code .token.function,
.markdown-rendered pre code .token.class-name,
.markdown-rendered pre code .token.builtin {
  color: {code_function};
}

.markdown-rendered pre code .token.property,
.markdown-rendered pre code .token.variable,
.markdown-rendered pre code .token.parameter,
.markdown-rendered pre code .token.url,
.markdown-rendered pre code .token.entity {
  color: {code_property};
}

.markdown-rendered pre code .token.important,
.markdown-rendered pre code .token.regex {
  color: {code_important};
}

.markdown-rendered pre code .token.deleted,
.markdown-rendered pre code .token.invalid {
  color: {code_invalid};
}

.markdown-rendered pre code .token {
  color: {code_text};
}

blockquote,
.markdown-rendered blockquote {
  color: var(--core-muted);
  border-left: 2px solid var(--core-signal);
  background: transparent;
}

mark,
.cm-highlight,
.markdown-rendered mark {
  color: {highlight};
  background: {highlight_bg}{apps.obsidian.highlight_alpha};
}

.cm-searching {
  color: var(--core-fg-bright);
  background: {highlight_bg}{apps.obsidian.highlight_alpha};
}

hr,
.markdown-rendered hr {
  border-color: var(--core-border);
}

input,
textarea,
select,
.dropdown {
  border-radius: 3px;
}

button {
  border-radius: 3px;
}

input:focus,
textarea:focus,
select:focus {
  border-color: var(--core-signal);
  box-shadow: 0 0 0 1px {accent}2E;
}

button.mod-cta,
button.mod-warning,
.modal-sidebar-list-item.is-active {
  color: var(--core-control-legend);
}

button.mod-warning,
button.mod-destructive.mod-cta {
  background-color: var(--core-fault);
}

.menu,
.suggestion-container,
.prompt,
.modal {
  background: var(--core-chrome-alt);
  border: 1px solid var(--core-border);
  border-radius: 5px;
  box-shadow:
    0 12px 40px {canvas}73;
}

.menu-item,
.suggestion-item {
  border-radius: 3px;
}

.suggestion-item.is-selected,
.menu-item.selected,
.menu-item:not(.is-label):not(.is-disabled).selected,
.menu-item:hover {
  color: var(--core-fg-bright);
  background: {hover};
}

.prompt-input,
.prompt input[type="text"] {
  color: var(--core-fg);
  background: var(--core-chrome);
}

.graph-view.color-line {
  color: var(--core-border);
}

.graph-view.color-fill {
  color: var(--core-signal);
}

.graph-view.color-fill-highlight {
  color: var(--core-signal-bright);
}

.graph-view.color-text {
  color: var(--core-fg);
}

.graph-view.color-fill-unresolved {
  color: var(--core-dim);
}

.graph-view.color-fill-tag {
  color: var(--core-command);
}

.graph-view.color-fill-attachment {
  color: var(--core-meta);
}

.status-bar {
  color: var(--status-bar-text-color);
  background: var(--status-bar-background);
  border-top: 1px solid var(--core-border);
  border-radius: 0;
}

.status-bar-item:hover {
  color: var({apps.obsidian.status_hover_var});
}

.tooltip {
  color: var(--core-fg);
  background: var(--core-surface-2);
  border: 1px solid var(--core-border);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb {
  background: {scrollbar};
}

::-webkit-scrollbar-thumb:hover {
  background: var({apps.obsidian.scrollbar_hover_var});
}

::-webkit-scrollbar-thumb:active {
  background: var(--core-border-bright);
}
