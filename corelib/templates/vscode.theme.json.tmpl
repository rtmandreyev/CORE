{
    "$schema": "vscode://schemas/color-theme",
    "name": "{theme_name}",
    "type": "{mode}",

    "colors": {
        "editor.background": "{canvas}",
        "editor.foreground": "{body}",

        "sideBar.background": "{surface}",
        "sideBar.foreground": "{metadata_emphasis}",
        "sideBar.border": "{border}",

        "activityBar.background": "{canvas}",
        "activityBar.foreground": "{accent}",
        "activityBar.inactiveForeground": "{metadata}",
        "activityBar.border": "{border}",

        "titleBar.activeBackground": "{canvas}",
        "titleBar.activeForeground": "{body}",
        "titleBar.inactiveBackground": "{canvas}",
        "titleBar.inactiveForeground": "{metadata}",

        "statusBar.background": "{surface_raised}",
        "statusBar.foreground": "{metadata_emphasis}",
        "statusBar.border": "{border}",

        "statusBar.noFolderBackground": "{surface_raised}",
        "statusBar.noFolderForeground": "{metadata_emphasis}",

        "statusBar.debuggingBackground": "{selection}",
        "statusBar.debuggingForeground": "{strong}",
        "statusBar.debuggingBorder": "{accent_strong}",

        "statusBarItem.hoverBackground": "{surface_raised}",
        "statusBarItem.hoverForeground": "{strong}",

        "statusBarItem.activeBackground": "{selection}",

        "statusBarItem.prominentBackground": "{surface_raised}",
        "statusBarItem.prominentForeground": "{strong}",
        "statusBarItem.prominentHoverBackground": "{selection}",

        "statusBarItem.errorBackground": "{error}",
        "statusBarItem.errorForeground": "{canvas}",

        "statusBarItem.warningBackground": "{badge}",
        "statusBarItem.warningForeground": "{badge_text}",

        "statusBarItem.remoteBackground": "{surface_raised}",
        "statusBarItem.remoteForeground": "{accent_strong}",

        "panel.background": "{surface}",
        "panel.border": "{border}",

        "terminal.background": "{canvas}",
        "terminal.foreground": "{body}",
        "terminalCursor.foreground": "{cursor}",

        "editorCursor.foreground": "{cursor}",

        "editor.selectionBackground": "{selection}CC",
        "editor.inactiveSelectionBackground": "{selection}66",
        "editor.lineHighlightBackground": "{surface}",

        "editorLineNumber.foreground": "{metadata}",
        "editorLineNumber.activeForeground": "{accent}",

        "editorIndentGuide.background1": "{border}",
        "editorIndentGuide.activeBackground1": "{border_emphasis}",

        "focusBorder": "{focus}",

        "list.activeSelectionBackground": "{selection}",
        "list.activeSelectionForeground": "{selection_foreground}",
        "list.inactiveSelectionBackground": "{surface_raised}",
        "list.hoverBackground": "{surface_raised}",

        "input.background": "{surface}",
        "input.foreground": "{body}",
        "input.border": "{border_emphasis}",

        "scrollbarSlider.background": "{border_emphasis}66",
        "scrollbarSlider.hoverBackground": "{accent}66",
        "scrollbarSlider.activeBackground": "{accent_strong}88",

        "editorBracketHighlight.foreground1": "{accent_strong}",
        "editorBracketHighlight.foreground2": "{string}",
        "editorBracketHighlight.foreground3": "{metadata}",
        "editorBracketHighlight.foreground4": "{accent_strong}",
        "editorBracketHighlight.foreground5": "{string}",
        "editorBracketHighlight.foreground6": "{metadata}",
        "editorBracketHighlight.unexpectedBracket.foreground": "{invalid}",

        "tab.activeBackground": "{surface}",
        "tab.activeForeground": "{strong}",
        "tab.inactiveBackground": "{canvas}",
        "tab.inactiveForeground": "{metadata}",
        "tab.hoverBackground": "{surface_raised}",
        "tab.activeBorderTop": "{accent_strong}",
        "tab.border": "{border}",

        "editorGroupHeader.tabsBackground": "{canvas}",
        "editorGroup.border": "{border}",

        "gitDecoration.modifiedResourceForeground": "{modified}",
        "gitDecoration.addedResourceForeground": "{success}",
        "gitDecoration.deletedResourceForeground": "{error}",
        "gitDecoration.untrackedResourceForeground": "{accent_strong}",
        "gitDecoration.ignoredResourceForeground": "{metadata}",
        "gitDecoration.conflictingResourceForeground": "{warning}",

        "problemsErrorIcon.foreground": "{error}",
        "problemsWarningIcon.foreground": "{warning}",
        "problemsInfoIcon.foreground": "{metadata_emphasis}",

        "editorWarning.foreground": "{warning}",
        "editorWarning.border": "{warning}",
        "list.warningForeground": "{warning}",

        "badge.background": "{badge}",
        "badge.foreground": "{badge_text}",

        "progressBar.background": "{accent}"
    },

    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "{comment}",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.control.import",
                "keyword.control.import.python"
            ],
            "settings": {
                "foreground": "{keyword}"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double"
            ],
            "settings": {
                "foreground": "{string}"
            }
        },
        {
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "{number}"
            }
        },
        {
            "scope": [
                "constant.language",
                "constant.other"
            ],
            "settings": {
                "foreground": "{constant}"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "{function}"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "{type}"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "{variable}"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.delimiter"
            ],
            "settings": {
                "foreground": "{operator}"
            }
        }
    ],

    "semanticHighlighting": true,

    "semanticTokenColors": {
        "class": "{type}",
        "type": "{type}",
        "interface": "{type}",

        "function": "{function}",
        "method": "{function}",

        "variable": "{variable}",
        "parameter": "{parameter}",
        "property": "{operator}",

        "namespace": "{metadata_emphasis}",

        "enum": "{constant}",
        "enumMember": "{constant}",

        "decorator": "{modified}"
    },

    "__generated": "CORE theme compiler; do not edit manually."
}
