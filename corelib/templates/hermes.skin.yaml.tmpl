customCSS: |
  /* CORE {theme_name}: text selection follows the theme (Hermes Desktop). */
  :root, :root.dark {
    --ui-selection-background: {apps.hermes.selection_css};
  }
  *::selection {
    background: {apps.hermes.selection_css};
  }
  .cm-editor .cm-selectionBackground,
  .cm-editor.cm-focused .cm-selectionBackground {
    background: {apps.hermes.selection_css} !important;
  }
