# {theme_name} for Starship.
# Generated by CORE from themes/{theme_id}/theme.toml; do not edit this file.
add_newline = true

format = """
[╭─]({prompt.frame})[ {theme_brand}]({prompt.brand})[ // ]({prompt.separator})$directory$git_branch$git_status$python$conda
[╰─]({prompt.frame})$character"""

[directory]
style = "bold {prompt.directory}"
format = "[$path]($style) "
truncation_length = 3
truncate_to_repo = false

[git_branch]
symbol = " "
style = "bold {prompt.git_branch}"
format = "[// ]({prompt.separator})[$symbol$branch]($style) "

[git_status]
style = "bold {prompt.git_status}"
format = "[$all_status$ahead_behind]($style) "

[python]
symbol = " "
style = "{apps.starship.runtime_weight}{prompt.runtime}"
format = "[// ]({prompt.separator})[$symbol${version}]($style) "

[conda]
symbol = " "
style = "{apps.starship.runtime_weight}{prompt.environment}"
format = "[// ]({prompt.separator})[$symbol$environment]($style) "

[character]
success_symbol = "[❯]({apps.starship.symbol_weight}{prompt.success})"
error_symbol = "[❯]({apps.starship.symbol_weight}{prompt.error})"
vimcmd_symbol = "[❮]({apps.starship.symbol_weight}{prompt.vim_command})"
